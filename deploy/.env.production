# ========== 必填 ==========
# LLM API Key（语音解析用）
# DeepSeek: https://platform.deepseek.com/api_keys
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-api-key-here

# S3 对象存储（每日备份）
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=bill-backups
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ========== 强烈建议修改 ==========
JWT_SECRET=change-me-in-production-use-random-string
ADMIN_KEY=admin-change-me

# ========== 可选 ==========
APP_PORT=8080
DB_PATH=/opt/bill/bill.db
LOG_PATH=/opt/bill/bill.log

# HTTPS（留空=HTTP，推荐用 Caddy/nginx 反代）
# TLS_CERT=/etc/ssl/certs/bill.pem
# TLS_KEY=/etc/ssl/private/bill.key

# sherpa-onnx 本地语音识别
ASR_PROVIDER=sherpa-onnx
ASR_MODEL_PATH=/opt/bill/models/sense-voice
ASR_SHERPA_BIN=/opt/bill/scripts/asr.py
ASR_PYTHON=/opt/bill/.venv/bin/python3
