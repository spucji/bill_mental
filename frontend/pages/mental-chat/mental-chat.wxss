/* --- 基础布局 --- */
.page-root {
  min-height: 100vh;
  background-color: #f8faf8;
  transition: all 0.5s ease;
  padding-bottom: 60rpx;
}

/* --- 主题变量定义 --- */
.theme-sister { --main-color: #1b5e20; --accent-color: #4caf50; --bg-gradient: #2e7d32; --light-color: #f1f8e9; }
.theme-younger_sister { --main-color: #880e4f; --accent-color: #e91e63; --bg-gradient: #d81b60; --light-color: #fce4ec; }
.theme-friend { --main-color: #e65100; --accent-color: #ff9800; --bg-gradient: #ef6c00; --light-color: #fff3e0; }

.container { padding: 0 30rpx; }

/* --- 顶部问候与 Tab --- */
.welcome-header {
  padding: 100rpx 40rpx 40rpx;
  background: linear-gradient(180deg, var(--bg-gradient), #f8faf8);
  color: #ffffff;
}
.greeting { font-size: 44rpx; font-weight: bold; display: block; text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2); }
.sub-greeting { font-size: 26rpx; opacity: 0.9; margin-top: 10rpx; display: block; }

.theme-switcher {
  display: flex; gap: 20rpx; margin-top: 40rpx;
}
.tab-item {
  padding: 12rpx 30rpx; font-size: 24rpx; border-radius: 40rpx;
  background: rgba(255,255,255,0.15); border: 1rpx solid rgba(255,255,255,0.3);
}
.tab-item.active { background: #fff; color: var(--main-color); font-weight: bold; }

/* --- 历史记录入口样式 --- */
.history-link-bar {
  text-align: right;
  padding: 20rpx 40rpx;
  margin-top: -10rpx;
}
.history-link-text {
  color: var(--main-color);
  font-size: 26rpx;
  font-weight: 500;
  text-decoration: underline;
  opacity: 0.8;
}

/* --- 卡片通用样式 --- */
.section-card {
  background: #fff; border-radius: 30rpx; padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
}
.header { margin-bottom: 30rpx; }
.title { font-size: 36rpx; font-weight: bold; color: var(--main-color); }
.subtitle { font-size: 24rpx; color: #888; display: block; margin-top: 10rpx; }

/* --- 输入框与按钮 --- */
.emotion-input {
  width: 100%; height: 240rpx; background: #f9f9f9; border-radius: 20rpx;
  padding: 20rpx; box-sizing: border-box; font-size: 28rpx; margin-bottom: 30rpx;
}
.submit-btn {
  background: linear-gradient(90deg, var(--main-color), var(--accent-color)) !important;
  color: #ffffff !important;
  font-weight: bold !important;
  font-size: 32rpx !important;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  border-radius: 50rpx;
  border: none !important;
}

/* --- 干预组件样式 --- */
.intervention-card { border-top: 10rpx solid var(--main-color); }
.section-title { font-size: 30rpx; font-weight: bold; color: #444; margin-bottom: 30rpx; display: block; }

/* --- 呼吸球模块 --- */
.breathing-container { 
  text-align: center; 
  padding: 20rpx 0; 
  height: 420rpx; 
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}
.breathing-circle {
  width: 140rpx; 
  height: 140rpx; 
  background: radial-gradient(circle, var(--accent-color), var(--main-color));
  border-radius: 50%; 
  transition: all 4s ease-in-out;
  box-shadow: 0 0 40rpx var(--accent-color);
  z-index: 1;
}
.expand { transform: scale(1.5); opacity: 0.9; box-shadow: 0 0 60rpx var(--accent-color); }
.shrink { transform: scale(0.8); opacity: 0.4; }
.breathing-hint {
  color: var(--main-color);
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 60rpx;
  display: block;
}

/* --- 拼图动画 --- */
.sheep-assembly-area { position: relative; height: 300rpx; width: 300rpx; margin: 0 auto; }
.sheep-part { position: absolute; width: 100%; height: 100%; font-size: 140rpx; opacity: 0; transition: 0.5s; display: flex; justify-content: center; align-items: center;}
.sheep-part.active { opacity: 1; }
.sheep-fly-animation { animation: sheepFly 2s forwards; }
@keyframes sheepFly { 100% { transform: translateY(-500rpx) scale(0); opacity: 0; } }

/* --- 按钮细节 --- */
.stop-btn {
  background: #fff !important; color: #ff5252 !important; border: 2rpx solid #ff5252 !important;
  border-radius: 50rpx; font-size: 24rpx;
}
.stop-btn-mini { 
  font-size: 24rpx; background: #fee; color: #e53935; border: 1rpx solid #ffcdd2; 
  border-radius: 30rpx; padding: 4rpx 15rpx;
}
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }

/* --- 全局浮窗 --- */
.global-breathing-trigger {
  position: fixed; right: 30rpx; bottom: 180rpx; width: 80rpx; height: 80rpx;
  background: var(--main-color); border-radius: 50%; display: flex; align-items: center; justify-content: center;
  z-index: 999; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2); border: 4rpx solid #fff;
}
.mini-circle-pulse {
  width: 30rpx; height: 30rpx; background: rgba(255,255,255,0.8); border-radius: 50%;
  animation: pulse 4s infinite;
}
@keyframes pulse { 0% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.8); opacity: 0.3; } 100% { transform: scale(1); opacity: 0.8; } }

/* --- 碎纸机 --- */
.shred-input { background: #f5f5f5; padding: 20rpx; border-radius: 15rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.shredder-machine { text-align: center; padding: 30rpx; background: #fff; border: 2rpx dashed var(--main-color); border-radius: 20rpx; }
.shaking { animation: shake 0.5s infinite; }
@keyframes shake { 0% { transform: translateX(0); } 25% { transform: translateX(5rpx); } 75% { transform: translateX(-5rpx); } }

/* --- 结果显示 --- */
.result-section { margin-bottom: 40rpx; }
.result-card { background: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--main-color); }
.result-card.highlight { border-left-color: var(--accent-color); background: var(--light-color); }
.card-label { font-size: 24rpx; color: #888; display: block; margin-bottom: 10rpx; }
.card-content { font-size: 28rpx; line-height: 1.6; color: #333; }