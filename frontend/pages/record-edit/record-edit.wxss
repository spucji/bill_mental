.edit-page {
  min-height: 100vh;
  background: var(--bg-oat);
  padding: 24rpx;
  position: relative;
}

.ambient-orb.orb-edit {
  position: absolute;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(180,170,150,0.1), transparent);
  top: 40rpx; left: -60rpx;
  border-radius: 50%;
  pointer-events: none;
}

/* 类型切换 */
.type-switch {
  display: flex;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  background: rgba(0,0,0,0.04);
  color: var(--text-muted);
  font-size: 28rpx;
  transition: all 0.2s;
}

.expense-active {
  background: rgba(201,92,79,0.1);
  color: var(--expense);
  font-weight: 600;
}

.income-active {
  background: rgba(91,140,90,0.1);
  color: var(--income);
  font-weight: 600;
}

/* 表单行 */
.edit-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.edit-row:last-child { border-bottom: none; }

.edit-label {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.amount-input {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.edit-input, .picker-val {
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

/* 类目/平台横向滚动 */
.chip-scroll {
  white-space: nowrap;
  margin-top: 10rpx;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
}

.chip-cell {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.04);
  color: var(--text-secondary);
  font-size: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.15s;
}

.chip-cell-active {
  background: var(--text-primary);
  color: #fff;
}

/* 标签网格 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.tag-cell {
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.04);
  color: var(--text-secondary);
  font-size: 24rpx;
  transition: all 0.15s;
}

.tag-cell-active {
  background: var(--text-primary);
  color: #fff;
}

.tag-link {
  display: inline-block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 操作 */
.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.del-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn {
  flex: 1;
  padding: 22rpx 0;
  letter-spacing: 4rpx;
}

.voice-raw-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.03);
  border-radius: 12rpx;
  border-left: 4rpx solid #C9705A;
}

.voice-raw-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6rpx;
}

.voice-raw-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
}
