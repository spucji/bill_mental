.stats-page {
  min-height: 100vh;
  background: var(--bg-oat);
  padding: 16rpx 28rpx 120rpx;
  position: relative;
}

.ambient-orb.orb-stats {
  position: absolute;
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(160,170,190,0.08), transparent);
  top: 0; right: -80rpx;
  border-radius: 50%;
  pointer-events: none;
}

/* 筛选矩阵 */
.filter-matrix { padding: 20rpx 24rpx; }

.filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.filter-row:last-child { margin-bottom: 0; }

.filter-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 8rpx;
}

.filter-sep {
  color: var(--text-muted);
  font-size: 24rpx;
}

.filter-chip {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.04);
  color: var(--text-secondary);
  font-size: 24rpx;
  transition: all 0.15s;
}

.filter-chip:active { transform: scale(0.95); }

.chip-active {
  background: var(--text-primary);
  color: #fff;
}

.filter-tags { max-height: 200rpx; overflow-y: auto; }

/* 汇总 */
.summary-card { margin-top: 16rpx; }

.summary-row {
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 6rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.summary-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.06);
}

.summary-ratio {
  text-align: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.ratio-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 图表 */
.chart-card {
  margin-top: 16rpx;
  padding: 16rpx;
  height: 520rpx;
}

.chart-empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 标签明细条 */
.tag-row { margin-bottom: 16rpx; }

.tag-bar-bg {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(0,0,0,0.04);
  margin-bottom: 8rpx;
  overflow: hidden;
}

.tag-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--text-primary);
  transition: width 0.5s ease;
}

.tag-row-info {
  display: flex;
  justify-content: space-between;
}

.tag-row-name { font-size: 26rpx; color: var(--text-secondary); }
.tag-row-amount { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
