/* pages/history/history.wxss */
page {
  background-color: #f6f8f9;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
}

.history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* --- 顶部筛选栏美化 --- */
.filter-sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.filter-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 15rpx 0;
  border: 1rpx solid #efefef;
}

.picker-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.picker-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.divider {
  width: 1rpx;
  height: 40rpx;
  background-color: #eee;
}

/* --- 列表与时间轴布局 --- */
.history-list-scroll {
  flex: 1;
}

.list-container {
  padding: 30rpx 40rpx 60rpx 60rpx; /* 为左侧时间轴留出空间 */
  position: relative;
}

/* 垂直线 */
.list-container::before {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 40rpx;
  bottom: 60rpx;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-item {
  position: relative;
  margin-bottom: 40rpx;
}

.timeline-dot {
  position: absolute;
  left: -38rpx;
  top: 30rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  border: 4rpx solid #fff;
  z-index: 2;
  box-shadow: 0 0 10rpx rgba(0,0,0,0.1);
}

.dot-sister { background-color: #2e7d32; }
.dot-younger_sister { background-color: #d81b60; }
.dot-friend { background-color: #ef6c00; }

/* --- 对话卡片美化 --- */
.chat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.theme-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.tag-sister { background: #e8f5e9; color: #2e7d32; }
.tag-younger_sister { background: #fce4ec; color: #d81b60; }
.tag-friend { background: #fff3e0; color: #ef6c00; }

.time-stamp {
  font-size: 22rpx;
  color: #bbb;
}

/* --- 对话气泡样式 --- */
.msg-row {
  display: flex;
  margin-top: 10rpx;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #f0f0f0;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #999;
  flex-shrink: 0;
}

.bubble {
  margin-left: 15rpx;
  padding: 18rpx 24rpx;
  border-radius: 0 20rpx 20rpx 20rpx;
  max-width: 85%;
}

.row-user .bubble {
  background-color: #f1f8e9;
  border: 1rpx solid #e1eed4;
}

.row-ai .bubble {
  background-color: #f9f9f9;
  border: 1rpx solid #efefef;
}

.row-user .avatar { background: #2e7d32; color: #fff; }
.row-ai .avatar { background: #ef6c00; color: #fff; }

.content-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #444;
  word-break: break-all;
}

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}