.mine-page {
  min-height: 100vh;
  background: var(--bg-oat);
  padding: 24rpx;
  position: relative;
}

.ambient-orb.orb-mine {
  position: absolute;
  width: 350rpx; height: 350rpx;
  background: radial-gradient(circle, rgba(170,160,140,0.08), transparent);
  bottom: 0; left: -100rpx;
  border-radius: 50%;
  pointer-events: none;
}

.profile-card {
  text-align: center;
  padding: 56rpx 0 40rpx;
  margin-bottom: 24rpx;
}

.avatar { font-size: 80rpx; display: block; margin-bottom: 16rpx; }

.account-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.account-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.menu-card {
  margin-bottom: 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.menu-arrow { color: var(--text-muted); font-size: 32rpx; }
.menu-val { color: var(--text-muted); font-size: 24rpx; }

.logout-btn {
  margin-top: 48rpx;
  text-align: center;
  padding: 28rpx;
}

.logout-text {
  color: var(--expense);
  font-size: 28rpx;
}
