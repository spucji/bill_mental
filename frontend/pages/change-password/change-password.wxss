.page { padding: 16px; }
.form-card { padding: 24px 20px; }
.form-title { font-size: 20px; font-weight: 700; margin-bottom: 24px; text-align: center; }
.form-group { margin-bottom: 16px; }
.form-label { font-size: 13px; color: #B5B3B0; display: block; margin-bottom: 6px; }
.form-input { width: 100%; height: 52px; padding: 0 18px; border: 1px solid rgba(0,0,0,0.08); border-radius: 14px; font-size: 17px; background: rgba(0,0,0,0.02); box-sizing: border-box; }
.pwd-row { display: flex; align-items: center; margin-top: 8px; }
.pwd-check { width: 18px; height: 18px; border: 2rpx solid #B5B3B0; border-radius: 4px; margin-right: 8px; font-size: 12px; color: #fff; display: flex; align-items: center; justify-content: center; }
.pwd-check.checked { background: #4A4946; border-color: #4A4946; }
.pwd-label { font-size: 14px; color: #B5B3B0; }
.btn-primary { margin-top: 12px; }
