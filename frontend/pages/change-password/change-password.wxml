<view class="page">
  <view class="card form-card">
    <view class="form-title">修改密码</view>

    <view class="form-group">
      <text class="form-label">旧密码</text>
      <input class="form-input" password="{{!showOld}}" placeholder="输入旧密码" value="{{oldPassword}}" bindinput="onOldInput" />
      <view class="pwd-row" bindtap="toggleOld">
        <view class="pwd-check {{showOld ? 'checked' : ''}}">{{showOld ? '✓' : ''}}</view>
        <text class="pwd-label">显示密码</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">新密码（至少 4 位）</text>
      <input class="form-input" password="{{!showNew}}" placeholder="输入新密码" value="{{newPassword}}" bindinput="onNewInput" />
      <view class="pwd-row" bindtap="toggleNew">
        <view class="pwd-check {{showNew ? 'checked' : ''}}">{{showNew ? '✓' : ''}}</view>
        <text class="pwd-label">显示密码</text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">确认新密码</text>
      <input class="form-input" password="{{!showConfirm}}" placeholder="再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
      <view class="pwd-row" bindtap="toggleConfirm">
        <view class="pwd-check {{showConfirm ? 'checked' : ''}}">{{showConfirm ? '✓' : ''}}</view>
        <text class="pwd-label">显示密码</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="doSubmit">确认修改</button>
  </view>
</view>
