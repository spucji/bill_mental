<view class="space-page">
  <view class="hero">
    <text class="eyebrow">欢迎回来</text>
    <text class="title">{{account}}</text>
    <text class="subtitle">今天想照看哪一部分生活？</text>
  </view>

  <view class="space-card bill" bindtap="goBill">
    <view class="space-icon">¥</view>
    <view class="space-copy">
      <text class="space-title">轻记账</text>
      <text class="space-desc">记录收支、管理分类、查看趋势</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="space-card mental" bindtap="goMental">
    <view class="space-icon">心</view>
    <view class="space-copy">
      <text class="space-title">心灵空间</text>
      <text class="space-desc">情绪对话、成长记录、白噪音陪伴</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <button class="ghost-btn" bindtap="goMine">账号与服务器设置</button>
</view>
