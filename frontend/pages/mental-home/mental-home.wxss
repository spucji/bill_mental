.home-container {
  min-height: 100vh;
  background: #fcfdfc;
  padding: 40rpx;
}

/* 欢迎区域 */
.welcome-section {
  padding: 20rpx 0 40rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-msg {
  font-size: 28rpx;
  color: #558b2f;
  font-weight: 500;
  text-align: center;
  animation: fadeIn 1s ease;
}

.loading-text {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 15rpx;
}

.loading-pulse {
  width: 12rpx;
  height: 12rpx;
  background-color: #2e7d32;
  border-radius: 50%;
  animation: pulse 1.5s infinite ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.5; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 头部样式 */
.home-header {
  padding: 20rpx 0 60rpx;
  text-align: center;
}
.home-title {
  font-size: 46rpx;
  font-weight: bold;
  color: #2e7d32;
  letter-spacing: 2rpx;
}
.home-subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 20rpx;
  display: block;
}

/* 卡片样式 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.theme-card {
  display: flex;
  align-items: center;
  padding: 45rpx 40rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
  position: relative;
  border: 1rpx solid #f0f0f0;
}

.theme-card:active { transform: scale(0.98); }
.sister { border-left: 12rpx solid #2e7d32; }
.younger_sister { border-left: 12rpx solid #d81b60; }
.friend { border-left: 12rpx solid #ef6c00; }

.icon-box {
  width: 100rpx;
  height: 100rpx;
  background: #f8faf8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 30rpx;
}

.text-group { flex: 1; }
.name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.desc { font-size: 24rpx; color: #999; }
.arrow { color: #ddd; font-size: 30rpx; }

/* 工具栏 */
.quick-tools {
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
  margin-top: 80rpx;
  margin-bottom: 60rpx;
}

.tool-item {
  flex: 1;
  background: #ffffff;
  padding: 30rpx 0;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.03);
  border: 1rpx solid #f0f0f0;
}

.tool-text {
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

/* 底部 */
.home-footer {
  text-align: center;
  padding-bottom: 60rpx;
}
.home-footer text {
  font-size: 24rpx;
  color: #bbb;
  letter-spacing: 1rpx;
}