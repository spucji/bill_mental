/* 折叠行 */
.cal-collapsed {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  gap: 4rpx;
}

.cal-summary {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.cal-summary-arrow {
  color: var(--text-muted);
  font-size: 24rpx;
  margin: 0 4rpx;
}

.cal-expand-icon {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
}

/* 展开状态 */
.cal {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx;
  padding: 16rpx 20rpx 20rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 12rpx;
}

.cal-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
  padding: 0 36rpx;
  font-weight: 300;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  min-width: 240rpx;
  text-align: center;
  color: var(--text-primary);
}

.cal-weekdays {
  display: flex;
  padding: 4rpx 0 12rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.cal-wd-wk { color: #C95C4F; }

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cal-cell-blank { pointer-events: none; }

.cal-day-num {
  font-size: 28rpx;
  color: var(--text-primary);
  z-index: 1;
}

.cal-today { font-weight: 700; }

.cal-today .cal-day-num { color: #4A90D9; }

.cal-today::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4A90D9;
}

.cal-start, .cal-end {
  background: var(--text-primary);
  border-radius: 50%;
}

.cal-start .cal-day-num,
.cal-end .cal-day-num { color: #fff; }

.cal-range { background: rgba(0,0,0,0.06); }

.cal-range .cal-day-num { color: var(--text-primary); }

/* 收起步 */
.cal-foot {
  text-align: center;
  padding: 12rpx 0 0;
}

.cal-fold {
  font-size: 22rpx;
  color: var(--text-muted);
}
