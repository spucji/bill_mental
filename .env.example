# ========== 必填 ==========
# AI 语音解析（使用语音功能必填）
# DeepSeek: https://platform.deepseek.com → API Keys
# 豆包: https://console.volcengine.com/ark → API Key
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-api-key-here

# ========== 强烈建议修改 ==========
JWT_SECRET=change-me-in-production-use-random-string
ADMIN_KEY=admin-change-me

# ========== 可选 ==========
APP_PORT=8080
DB_PATH=./bill.db
LOG_PATH=./bill.log

# HTTPS（留空则用 HTTP）
# TLS_CERT=/opt/bill/certs/fullchain.pem
# TLS_KEY=/opt/bill/certs/privkey.pem

# sherpa-onnx 本地语音识别
# 安装依赖: bash scripts/download-sherpa.sh && bash scripts/download-model.sh
ASR_PROVIDER=sherpa-onnx
ASR_MODEL_PATH=./models/sense-voice
ASR_SHERPA_BIN=./scripts/asr.py
ASR_PYTHON=.venv/bin/python3
